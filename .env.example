# Copy to .env for `netlify dev`. Set the same names in Netlify → Site settings → Environment variables.
# Never put service_role or captcha SECRET in this repo or in public-config.

# Public (safe in browser with RLS) — served by /.netlify/functions/public-config
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Optional captcha SITE key (secret stays in Supabase Bot & Abuse Protection)
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=

# Optional public contact inbox (FormSubmit). Never put secrets here.
CONTACT_EMAIL=

# Optional PostHog project key (public; consent banner still required)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
